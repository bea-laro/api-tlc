<h4>Cursos e materiais</h4>
<p class="text-muted">Acesse os conteúdos oficiais do TLC.</p>
<form method="GET" action="/materiais" class="d-flex gap-2 mb-4" style="max-width: 500px;">
    <input type="text" class="form-control" name="busca" value="{{busca}}" placeholder="Buscar material...">
    <input type="submit" class="btn btn-laranja" value="Buscar">
</form>
<div class="row g-3">
    {{#each materiais}}
    <div class="col-lg-3 col-sm-6">
        <a href="/material/{{id}}" class="card card-tema text-decoration-none text-dark h-100">
            <div class="card-tema-topo"><i class="bi bi-journal-text"></i></div>
            <div class="p-3">
                <small class="text-muted text-uppercase">{{tipo}}</small>
                <h6 class="mb-1">{{titulo}}</h6>
                <small class="text-muted">{{descricao}}</small>
            </div>
        </a>
    </div>
    {{else}}
    <p class="text-muted">Nenhum material encontrado.</p>
    {{/each}}
</div>