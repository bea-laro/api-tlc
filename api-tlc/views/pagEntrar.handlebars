<main class="d-flex flex-column min-vh-100">
    {{!-- cabeçalho --}}
    <header class="w-100 p-3" style="background-color: #ff914d">
        <div class="row align-items-center g-0">
            <div class="col-2 ps-5">
                <img src="/img/logo.png" alt="Logo" class="img-fluid" style="max-width: 50px;">
            </div>
            <div class="col-8 text-center">
                <h1 class="m-0">Treinamento de Liderança Cristã</h1>
            </div>
            <div class="col-2"></div>
        </div>
    </header>
    {{!-- conteudo --}}
    <div class="container d-flex flex-column flex-grow-1">
        <div class="row pt-4 flex-grow-1">
            <div class="col-6 p-5 pt-3 rounded-start-4 d-flex flex-column justify-content-center align-items-center text-center" style="background-color: #ff914d">
                <div class="mb-6">
                    <img src="/img/logo.png" alt="Logo" class="img-fluid mb-5" style="max-width: 80px;">
                </div>
                <div class="mb-6 ">
                    <h1 class="fs-4">Seja bem-vindo!</h1>
                    <br>
                    <h1 class="fs-4">Para acessar a plataforma</h1> 
                    <h1 class="fs-4">logue com as suas informações pessoais.</h1>
                </div>
            </div>
            <div class="col-6 p-5 rounded-end-4 d-flex flex-column justify-content-center align-items-center text-center" style="background-color: rgb(248, 247, 246)">
                <h2 class="mb-4">Faça seu login</h2>

                <form class="w-100 text-start" style="max-width: 320px;">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control mb-3" id="email" name="email" placeholder="Digite seu E-mail">

                    <label for="senha" class="form-label">Senha</label>
                    <input type="password" class="form-control mb-4" id="senha" name="senha" placeholder="Digite sua Senha">

                    <input type="submit" class="btn btn-laranja w-100" value="Entrar">
                </form>

                <p class="mt-3 mb-0">
                    Não tem login? <a href="/cadastrar" class="link-cadastro">Fazer cadastro</a>
                </p>
            </div>
        </div>
    </div>

</main>