<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TLC</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/painel.css">
</head>
<body>
    <div class="d-flex">

        <aside class="menu">
            <div class="menu-logo">
                <img src="/img/logoLaranja.png" alt="TLC">
                <div>
                    <strong>TLC</strong>
                    <small>Regional Sul 1</small>
                </div>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link {{#if ativoHome}}ativo{{/if}}" href="/home"><i class="bi bi-house"></i> Início</a>
                <a class="nav-link {{#if ativoMateriais}}ativo{{/if}}" href="/materiais"><i class="bi bi-book"></i> Materiais</a>
                {{#if adm}}
                <a class="nav-link {{#if ativoEnviar}}ativo{{/if}}" href="/admin/materiais"><i class="bi bi-cloud-upload"></i> Enviar material <span class="selo-adm">ADM</span></a>
                <a class="nav-link {{#if ativoRelatorios}}ativo{{/if}}" href="/relatorios"><i class="bi bi-bar-chart"></i> Relatórios <span class="selo-adm">ADM</span></a>
                {{/if}}
                <a class="nav-link {{#if ativoPerfil}}ativo{{/if}}" href="/perfil"><i class="bi bi-person"></i> Meu perfil</a>
            </nav>

            <a class="nav-link mt-auto" href="/sair"><i class="bi bi-box-arrow-left"></i> Sair</a>
        </aside>

        <div class="flex-grow-1">
            <header class="topo">
                <span class="fs-5">{{titulo}}</span>
                <span class="d-flex align-items-center gap-2 fw-semibold">
                    {{nome}}
                    <i class="bi bi-person-circle fs-3"></i>
                </span>
            </header>
            <main class="p-4 conteudo">
                {{{body}}}
            </main>
        </div>

    </div>
</body>
</html>